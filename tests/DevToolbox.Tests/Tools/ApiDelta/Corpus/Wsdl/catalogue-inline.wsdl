<?xml version="1.0" encoding="utf-8"?>
<!-- La même livraison que catalogue.wsdl, en un seul document : les deux schémas sont écrits dans
     wsdl:types au lieu d'être importés. Rien d'autre ne change. C'est la décomposition du contrat en
     fichiers qui est éprouvée ici, et elle ne doit rien changer du tout — ni la couverture, ni les
     constats, ni le document engendré. -->
<wsdl:definitions
    name="Catalogue"
    targetNamespace="http://entreprise.local/catalogue/wsdl"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://entreprise.local/catalogue/wsdl"
    xmlns:t="http://entreprise.local/catalogue/types">

  <wsdl:documentation>
    Dépôt et consultation de documents. Le service en service depuis 2019.
  </wsdl:documentation>

  <wsdl:types>
    <xs:schema targetNamespace="http://entreprise.local/commun"
               xmlns:c="http://entreprise.local/commun"
               elementFormDefault="qualified">

      <xs:simpleType name="Identifiant">
        <xs:restriction base="xs:string">
          <xs:maxLength value="36"/>
          <xs:pattern value="[0-9a-fA-F-]{36}"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:simpleType name="Etat">
        <xs:restriction base="xs:string">
          <xs:enumeration value="brouillon"/>
          <xs:enumeration value="publie"/>
          <xs:enumeration value="archive"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:simpleType name="Priorite">
        <xs:restriction base="xs:int">
          <xs:minInclusive value="1"/>
          <xs:maxInclusive value="9"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:simpleType name="Trimestre">
        <xs:restriction base="xs:gYearMonth"/>
      </xs:simpleType>

      <xs:complexType name="Erreur">
        <xs:sequence>
          <xs:element name="code" type="xs:string"/>
          <xs:element name="message" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
    </xs:schema>

    <xs:schema targetNamespace="http://entreprise.local/catalogue/types"
               xmlns:t="http://entreprise.local/catalogue/types"
               xmlns:c="http://entreprise.local/commun"
               elementFormDefault="qualified">

      <!-- Aucun « schemaLocation » : le schéma importé est dans le même document, donc dans le même jeu. -->
      <xs:import namespace="http://entreprise.local/commun"/>

      <xs:complexType name="Document">
        <xs:sequence>
          <xs:element name="id" type="c:Identifiant"/>
          <xs:element name="titre" type="xs:string"/>
          <xs:element name="etat" type="c:Etat"/>
          <xs:element name="priorite" type="c:Priorite" minOccurs="0"/>
          <xs:element name="resume" type="xs:string" minOccurs="0" nillable="true"/>
          <xs:element name="motsCles" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="depose" type="xs:dateTime"/>
          <xs:element name="trimestre" type="c:Trimestre" minOccurs="0"/>
          <xs:element name="dossier" type="t:Dossier" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:int"/>
        <xs:attribute name="verrouille" type="xs:boolean"/>
      </xs:complexType>

      <xs:complexType name="Dossier">
        <xs:sequence>
          <xs:element name="id" type="c:Identifiant"/>
          <xs:element name="libelle" type="xs:string"/>
          <xs:element name="documents" type="t:Document" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="parent" type="t:Dossier" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="DocumentDetaille">
        <xs:complexContent>
          <xs:extension base="t:Document">
            <xs:sequence>
              <xs:element name="auteur" type="xs:string"/>
              <xs:element name="revisions" type="xs:int"/>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>

      <xs:complexType name="Critere">
        <xs:choice>
          <xs:element name="parId" type="c:Identifiant"/>
          <xs:element name="parTitre" type="xs:string"/>
          <xs:element name="parEtat" type="c:Etat"/>
        </xs:choice>
      </xs:complexType>

      <xs:complexType name="Pagination">
        <xs:all>
          <xs:element name="page" type="xs:int"/>
          <xs:element name="taille" type="xs:int"/>
        </xs:all>
      </xs:complexType>

      <xs:element name="piece" type="t:Document" abstract="true"/>
      <xs:element name="pieceJointe" type="t:Document" substitutionGroup="t:piece"/>
      <xs:element name="pieceSignee" type="t:DocumentDetaille" substitutionGroup="t:piece"/>

      <xs:element name="deposerDocumentRequete" type="t:DocumentDetaille"/>
      <xs:element name="deposerDocumentReponse" type="c:Identifiant"/>
      <xs:element name="lireDocumentRequete" type="t:Critere"/>
      <xs:element name="lireDocumentReponse" type="t:DocumentDetaille"/>
      <xs:element name="archiverDocumentAvis" type="c:Identifiant"/>
      <xs:element name="dossierModifieAvis" type="t:Dossier"/>
      <xs:element name="interrogerDossierDemande" type="t:Pagination"/>
      <xs:element name="interrogerDossierReponse" type="t:Dossier"/>
      <xs:element name="erreur" type="c:Erreur"/>
    </xs:schema>
  </wsdl:types>

  <wsdl:message name="deposerDocumentIn">
    <wsdl:part name="corps" element="t:deposerDocumentRequete"/>
  </wsdl:message>
  <wsdl:message name="deposerDocumentOut">
    <wsdl:part name="corps" element="t:deposerDocumentReponse"/>
  </wsdl:message>
  <wsdl:message name="lireDocumentIn">
    <wsdl:part name="corps" element="t:lireDocumentRequete"/>
  </wsdl:message>
  <wsdl:message name="lireDocumentOut">
    <wsdl:part name="corps" element="t:lireDocumentReponse"/>
  </wsdl:message>
  <wsdl:message name="archiverDocumentIn">
    <wsdl:part name="corps" element="t:archiverDocumentAvis"/>
  </wsdl:message>
  <wsdl:message name="dossierModifieOut">
    <wsdl:part name="corps" element="t:dossierModifieAvis"/>
  </wsdl:message>
  <wsdl:message name="interrogerDossierOut">
    <wsdl:part name="corps" element="t:interrogerDossierDemande"/>
  </wsdl:message>
  <wsdl:message name="interrogerDossierIn">
    <wsdl:part name="corps" element="t:interrogerDossierReponse"/>
  </wsdl:message>
  <wsdl:message name="erreurMessage">
    <wsdl:part name="corps" element="t:erreur"/>
  </wsdl:message>

  <wsdl:portType name="CataloguePort">
    <wsdl:operation name="deposerDocument">
      <wsdl:documentation>Dépose un document et rend son identifiant.</wsdl:documentation>
      <wsdl:input message="tns:deposerDocumentIn"/>
      <wsdl:output message="tns:deposerDocumentOut"/>
      <wsdl:fault name="erreur" message="tns:erreurMessage"/>
    </wsdl:operation>

    <wsdl:operation name="lireDocument">
      <wsdl:documentation>Lit un document par critère.</wsdl:documentation>
      <wsdl:input message="tns:lireDocumentIn"/>
      <wsdl:output message="tns:lireDocumentOut"/>
      <wsdl:fault name="erreur" message="tns:erreurMessage"/>
    </wsdl:operation>

    <wsdl:operation name="archiverDocument">
      <wsdl:documentation>Signale l'archivage. Rien n'est rendu.</wsdl:documentation>
      <wsdl:input message="tns:archiverDocumentIn"/>
    </wsdl:operation>

    <wsdl:operation name="dossierModifie">
      <wsdl:documentation>Avertit qu'un dossier a changé.</wsdl:documentation>
      <wsdl:output message="tns:dossierModifieOut"/>
    </wsdl:operation>

    <wsdl:operation name="interrogerDossier">
      <wsdl:documentation>Le service interroge, l'appelant répond.</wsdl:documentation>
      <wsdl:output message="tns:interrogerDossierOut"/>
      <wsdl:input message="tns:interrogerDossierIn"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="CatalogueBinding" type="tns:CataloguePort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="deposerDocument">
      <soap:operation soapAction="http://entreprise.local/catalogue/deposerDocument"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="erreur"><soap:fault name="erreur" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="lireDocument">
      <soap:operation soapAction="http://entreprise.local/catalogue/lireDocument"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="erreur"><soap:fault name="erreur" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="archiverDocument">
      <soap:operation soapAction="http://entreprise.local/catalogue/archiverDocument"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
    </wsdl:operation>
    <wsdl:operation name="dossierModifie">
      <soap:operation soapAction="http://entreprise.local/catalogue/dossierModifie"/>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="interrogerDossier">
      <soap:operation soapAction="http://entreprise.local/catalogue/interrogerDossier"/>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="Catalogue">
    <wsdl:documentation>Le point d'entrée du catalogue documentaire.</wsdl:documentation>
    <wsdl:port name="CataloguePort" binding="tns:CatalogueBinding">
      <soap:address location="https://catalogue.entreprise.local/services/catalogue"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
