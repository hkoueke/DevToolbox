root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 120

#### Conventions de langage ####

csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:error
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:error
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion

# Scellé par défaut. La règle de Meziantou signale les types internes ou publics non scellés.
dotnet_diagnostic.MA0053.severity = warning

#### Politique ConfigureAwait ####
# La politique est déclarée ici une seule fois, pour qu'elle ne dérive pas d'un projet à l'autre :
#   assemblages de bibliothèque  -> ConfigureAwait(false) est OBLIGATOIRE (CA2007 en erreur)
#   point d'entrée console       -> sans contrainte, car il n'y a aucun contexte de synchronisation à
#                                   capturer et l'ordre des continuations est indifférent pour une
#                                   application console bâtie sur l'hôte générique.
# Les dérogations par projet figurent dans les deux sections en fin de fichier.

dotnet_diagnostic.CA2007.severity = error

# CA1848 (utiliser des délégués LoggerMessage) est déjà satisfaite par les classes de journalisation générées
# à la source, mais la règle se déclenche aussi sur les sites d'appel du code généré sans rien apporter. Le
# générateur de source est le contrôle réel.
dotnet_diagnostic.CA1848.severity = none

#### Nommage ####

dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

#### Dérogation ConfigureAwait : racine de composition ####
# Le point d'entrée est le seul endroit où le synchrone sur asynchrone est admis, et le seul où attendre sans
# ConfigureAwait(false) ne présente aucun risque.

[src/DevToolbox.Console/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none

#### Dérogation ConfigureAwait : tests ####
# xUnit fournit son propre contexte de synchronisation, si bien que ConfigureAwait(false) n'est que du bruit
# dans les tests.

[tests/**/*.cs]
dotnet_diagnostic.CA2007.severity = none
# Les noms de méthodes de test se lisent comme des phrases, les tirets bas sont voulus.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0053.severity = none
